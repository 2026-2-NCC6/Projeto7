# Endereço do backend. Sem isso o app tenta o host do Metro na porta 3000.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# De onde vêm os impactos: "simulated" (padrão) ou "websocket" (a parede real).
# EXPO_PUBLIC_DEVICE_SOURCE=websocket

# Endereço da parede. O padrão é o IP fixo do ESP32 em modo SoftAP.
# Em modo Station use o IP da parede na rede local (ws://192.168.0.42:81).
# EXPO_PUBLIC_DEVICE_URL=ws://192.168.4.1:81
