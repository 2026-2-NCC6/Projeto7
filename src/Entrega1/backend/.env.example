DB_HOST=127.0.0.1
DB_PORT=5433
# Sem valor padrão no código: sem DB_USER e DB_PASSWORD a API não sobe.
DB_USER=smash
DB_PASSWORD=smash
DB_NAME=smash_entrega1

# Obrigatório, 32 caracteres ou mais. Gere com: openssl rand -base64 48
# A API não sobe com este valor de exemplo.
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h

PORT=3000

# Interface de escuta. O padrão do código é 127.0.0.1 (só esta máquina).
# 0.0.0.0 deixa o celular e o emulador na rede de testes alcançarem a API.
HOST=0.0.0.0

# Origens de navegador aceitas pelo CORS, separadas por vírgula. Vazio desliga o
# CORS; o app mobile não precisa dele.
# CORS_ORIGINS=http://localhost:5173

# HTTPS: com os dois caminhos definidos a API só responde por TLS.
# TLS_KEY_PATH=certs/key.pem
# TLS_CERT_PATH=certs/cert.pem

# true quando a API roda atrás de um proxy HTTPS: o IP do cliente vem do proxy,
# e a limitação de tentativas do login conta cada aparelho separado.
# TRUST_PROXY=true
